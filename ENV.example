# Configuración de Next.js / Aplicación
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Base de Datos, Auth y Storage)
NEXT_PUBLIC_SUPABASE_URL=TODO_CONFIGURE
NEXT_PUBLIC_SUPABASE_ANON_KEY=TODO_CONFIGURE
SUPABASE_SERVICE_ROLE_KEY=TODO_CONFIGURE

# Inteligencia Artificial (LLM)
AI_PROVIDER=openai
OPENAI_API_KEY="sk-tu-key-de-openai"
OPENAI_MODEL="gpt-4o-mini"

# Generación de Imágenes (Creative Engine)
IMAGE_PROVIDER="openai"
IMAGE_PROVIDER_MODEL="gpt-image-2.5-flare"

# Flag de pruebas en vivo (Solo si deseas ejecutar tests externos que consuman créditos reales)
RUN_EXTERNAL_IMAGE_TESTS=false

# n8n Webhooks (Si aplica)
N8N_WEBHOOK_URL=TODO_CONFIGURE

# Configuración de Negocio (CHP)
NEXT_PUBLIC_DEFAULT_WHATSAPP_NUMBER=TODO_CONFIGURE

# Cola de Publicación y Frecuencia (Fase 5)
MIN_DAYS_BETWEEN_GROUP_POSTS=3
DUPLICATE_WINDOW_DAYS=7
